# ==============================================================================
# LivingDocs AI Engine - Configuration Template
# Toàn bộ cấu hình hệ thống được thống nhất tại file .env ở thư mục gốc (Root D:\LivingDocs\.env)
# ==============================================================================

MODE=real
HOST=0.0.0.0
PORT=8000
FASTAPI_PORT=8000

# Google Gemini API Key (Hỗ trợ nhiều key cách nhau bằng dấu phẩy để tự động xoay vòng x10 Quota)
GEMINI_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2
