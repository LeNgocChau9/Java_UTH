# Database (PostgreSQL 16 + pgvector, docker compose)
# Copy this file to .env and fill in your own username and password.
# Do not commit .env.
POSTGRES_DB=livingdocs
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

DB_HOST=localhost
DB_PORT=5432
DB_NAME=livingdocs
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# GitHub OAuth App (LivingDocs Local Dev)
GITHUB_CLIENT_ID=Ov23liRyWxsd1w2R26sp
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
FASTAPI_PORT=8000
