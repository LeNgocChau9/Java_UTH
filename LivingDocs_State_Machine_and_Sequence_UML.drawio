<mxPoint x="805" y="680" /></Array></mxGeometry></mxCell><mxCell id="m22" parent="1" value="22. gitHubClient.createOrUpdateFile(...) -&gt; Trả về commitSha" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor:#047857;" edge="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="805" y="710" /><mxPoint x="1455" y="710" /></Array></mxGeometry></mxCell><mxCell id="m23" parent="1" value="23. documents.update(status = PUBLISHED) &amp; reviews.save(PUBLISHED)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11;fontColor:#166534;" edge="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="805" y="735" /><mxPoint x="1455" y="735" /></Array></mxGeometry></mxCell><mxCell id="m24" parent="1" value="24. recordDocumentApproval(...) &amp; recordDocumentAction(DOCUMENT_PUBLISHED, detail+sha)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#4F46E5;strokeWidth=1.5;fontSize=11;fontColor:#3730A3;" edge="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="805" y="765" /><mxPoint x="1275" y="765" /></Array></mxGeometry></mxCell><mxCell id="m25" parent="1" value="25. audit_logs.save(user_id, action, resource_type, detail)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11;fontColor:#166534;" edge="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1275" y="790" /><mxPoint x="1455" y="790" /></Array></mxGeometry></mxCell><mxCell id="m26" parent="1" value="26. 200 OK ReviewActionResponse (Đã xuất bản PUBLISHED + Commit SHA)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;fontColor:#6D28D9;" edge="1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="805" y="825" /><mxPoint x="335" y="825" /></Array></mxGeometry></mxCell><mxCell id="note_alt" parent="1" value="&lt;div style=&quot;font-size:10.5px;color:#475569;line-height:1.4;&quot;&gt;&lt;b&gt;Nhánh rẽ thay thế:&lt;/b&gt;&lt;br/&gt;• Nếu Manager chọn &lt;b&gt;RETURN_STAFF&lt;/b&gt;: Chuyển tài liệu về lại &lt;code&gt;UNDER_REVIEW_STAFF&lt;/code&gt;, ghi log &lt;code&gt;DOCUMENT_RETURNED_STAFF&lt;/code&gt;.&lt;br/&gt;• Nếu Staff hoặc Manager chọn &lt;b&gt;REJECT&lt;/b&gt;: Chuyển tài liệu sang &lt;code&gt;REJECTED&lt;/code&gt;, ghi log &lt;code&gt;DOCUMENT_REJECTED&lt;/code&gt; kèm lý do.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;rounded=1;align=left;verticalAlign=top;spacing=6;" vertex="1"><mxGeometry as="geometry" x="340" y="845" width="600" height="45" /></mxCell></root></mxGraphModel></diagram></mxfile>